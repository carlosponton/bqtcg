# Copia este archivo a .env.local y completa los valores.
# Los encuentras en Supabase → Project Settings → API Keys.

# URL del proyecto (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key: empieza con "sb_publishable_". Segura para el navegador.
# Reemplaza a la antigua "anon key" (la legacy aún funciona como respaldo).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key: empieza con "sb_secret_". SÓLO servidor, nunca la expongas al cliente.
# Reemplaza a la antigua "service_role". Aún no se usa en la Fase 0.
SUPABASE_SECRET_KEY=

# URL pública del sitio (para redirecciones de OAuth y correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endpoint de la API de TCGdex. Vacío = mirror por defecto
# (https://api.eu1.tcgdex.net/v2), porque el nodo principal api.tcgdex.net no es
# alcanzable desde algunas redes. Cuando vuelva: https://api.tcgdex.net/v2
TCGDEX_ENDPOINT=

# Resend (correo). Sin esto, los avisos por correo simplemente no se envían
# (las notificaciones in-app sí funcionan). Crea una API key en resend.com.
RESEND_API_KEY=
# Remitente. Para producción necesitas un dominio verificado en Resend; para
# probar sirve "TCG Barranquilla <onboarding@resend.dev>" (solo te llega a ti).
EMAIL_FROM=
